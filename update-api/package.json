{
  "name": "retailer-update-api",
  "version": "0.1.0",
  "private": true,
  "description": "Durable approved snapshot admission and guarded initial delivery",
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test dist/test/unit/*.test.js",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test --test-concurrency=1 dist/test/integration/*.test.js"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "mongodb": "7.7.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prettier": "3.7.4",
    "typescript": "7.0.2"
  }
}
