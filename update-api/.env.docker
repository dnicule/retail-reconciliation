# Copy to .env.docker only if that file does not exist, then supply existing credentials.
# Compose 2.30+ reads this file literally (format: raw): do not wrap values in quotes.
# URL-encode special characters in PostgreSQL usernames/passwords.
# These DNS names are the existing Compose service names on glue-local.
POSTGRES_URL=postgresql://appuser:local_dev_password@postgres:5432/myapp
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=retail_catalog
LOG_LEVEL=info
