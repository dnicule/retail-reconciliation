# Copy to .env.docker only if absent, then supply your existing database credentials.
# Compose 2.30+ reads values literally (format: raw); do not wrap values in quotes.
# URL-encode special characters in PostgreSQL usernames/passwords.
# Service DNS names resolve on the existing glue-local network.
POSTGRES_URL=postgres://appuser:local_dev_password@postgres:5432/myapp
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=retail_catalog
LOG_LEVEL=info
# Include authentication settings in MONGODB_URI if your existing server requires them.
# Worker timing, concurrency, and retry limits remain fixed in the application.
